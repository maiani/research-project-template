# LaTeX build files from notes compiled in workspace/; the manuscript has its
# own repository and ignore rules.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb

# Python
__pycache__/
*.py[codz]
*$py.class
*.so
.venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.*.swp

# Nested git repos — each has its own .git, not tracked by root
/manuscript/
/repository/

# Bibliography: track .bib files, ignore reference PDFs and API caches
/bibliography/*.files/
