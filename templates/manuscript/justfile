# Build from manuscript/; .latexmkrc owns engine and output configuration.
# With no arguments, build the main manuscript configured in .latexmkrc.
build *files:
    latexmk {{files}}

watch *files:
    latexmk -pvc {{files}}

# Remove auxiliary files, keeping PDFs.
clean *files:
    latexmk -c {{files}}

# Remove generated PDFs as well as auxiliary files.
clean-all *files:
    latexmk -C {{files}}

# ── Optional formatting ──

# Optionally format tracked LaTeX sources. Requires Badness; generated latexdiff sources are excluded.
format:
	#!/usr/bin/env bash
	set -euo pipefail
	command -v badness >/dev/null 2>&1 || { printf 'ERROR: badness is not installed.\n' >&2; exit 127; }
	files=()
	while IFS= read -r -d '' file; do
		[[ "$file" == *_diff.tex ]] || files+=("$file")
	done < <(git ls-files -z -- '*.tex' '*.bib' '*.cls' '*.sty')
	((${#files[@]} == 0)) || badness format --config badness.toml "${files[@]}"

# Optionally check formatting without modifying files. Requires Badness.
format-check:
	#!/usr/bin/env bash
	set -euo pipefail
	command -v badness >/dev/null 2>&1 || { printf 'ERROR: badness is not installed.\n' >&2; exit 127; }
	files=()
	while IFS= read -r -d '' file; do
		[[ "$file" == *_diff.tex ]] || files+=("$file")
	done < <(git ls-files -z -- '*.tex' '*.bib' '*.cls' '*.sty')
	((${#files[@]} == 0)) || badness format --config badness.toml --check "${files[@]}"

# Opt in to formatting and bibliography checks. Requires pre-commit.
install-hooks:
	#!/usr/bin/env bash
	set -euo pipefail
	command -v pre-commit >/dev/null 2>&1 || { printf 'ERROR: pre-commit is not installed.\n' >&2; exit 127; }
	pre-commit install
